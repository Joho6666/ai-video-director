APP_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=

# Production Agent: MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_MODEL=MiniMax-Hailuo-2.3

# Production Agent: Alibaba Wan (DashScope)
WAN_API_KEY=
WAN_BASE_URL=https://dashscope.aliyuncs.com
WAN_MODEL=wanx2.1-i2v-plus

# 自动合成首帧（full 模式、未上传首帧时）：模特图 + 商品图 + 参考镜头 → 首帧，复用上面的 WAN_API_KEY
# 每次合成约产生 1 次图像编辑费用 + 1 次 DeepSeek 检查；未通过检查则不提交视频
AUTO_COMPOSE_FIRST_FRAME=on
IMAGE_COMPOSE_MODEL=qwen-image-edit-plus

# Reference source providers (server-side only)
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
REDFOX_API_KEY=
REDFOX_BASE_URL=https://redfox.hk
