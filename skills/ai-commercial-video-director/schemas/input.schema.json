{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-commercial-video-director/input.schema.json",
  "title": "AI Commercial Video Director Input",
  "type": "object",
  "required": ["references", "product", "creative_brief", "target_models"],
  "properties": {
    "mode": {"enum": ["RECREATE", "INSPIRE", "FUSION"], "default": "INSPIRE"},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "type", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["video", "image", "text-analysis"]},
          "source": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["motion", "camera", "composition", "scene"]}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "product": {
      "type": "object", "required": ["name", "category", "selling_points"],
      "properties": {
        "name": {"type": "string"}, "category": {"type": "string"},
        "selling_points": {"type": "array", "items": {"type": "string"}},
        "must_show": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "description": {"type": "string"}, "styling": {"type": "string"},
        "wardrobe": {"type": "string"}, "props": {"type": "array", "items": {"type": "string"}},
        "consistency_requirements": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "creative_brief": {
      "type": "object", "required": ["platform", "commercial_goal", "aspect_ratio", "duration_seconds"],
      "properties": {
        "platform": {"type": "string"}, "audience": {"type": "string"},
        "commercial_goal": {"type": "string"}, "mood": {"type": "array", "items": {"type": "string"}},
        "scene": {"type": "string"}, "aspect_ratio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }, "additionalProperties": false
    },
    "target_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["google-flow-veo", "seedance"]}},
    "constraints": {
      "type": "object",
      "properties": {
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "brand": {"type": "array", "items": {"type": "string"}},
        "must_keep": {"type": "array", "items": {"type": "string"}},
        "must_change": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "variation_count": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5}
  },
  "additionalProperties": false
}
